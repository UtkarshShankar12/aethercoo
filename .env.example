# Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Backend API base URL (without trailing slash)
# Local development: http://localhost:8000
# Production: https://your-render-backend-url.onrender.com
VITE_API_URL=http://localhost:8000

# Backend WebSocket URL (replace http/https with ws/wss)
# Local development: ws://localhost:8000
# Production: wss://your-render-backend-url.onrender.com
VITE_WS_URL=ws://localhost:8000
